{
  "name": "video-extractor",
  "private": true,
  "version": "2.1.3",
  "license": "GPL-3.0",
  "main": "electron-main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "set VITE_DEV_SERVER_URL=http://127.0.0.1:5173 && wait-on tcp:5173 && electron .",
    "web": "vite",
    "preview": "vite preview",
    "build": "vite build && electron-builder --win dir",
    "build:setup": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.yourname.videoextractor",
    "productName": "视频截图神器",
    "icon": "public/icon.png",
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json",
      "public/icon.png"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "视频截图神器",
      "uninstallDisplayName": "视频截图神器"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}
